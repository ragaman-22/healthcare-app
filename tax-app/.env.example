# Supabase（未設定の場合はデモモードで起動します。データは保存されません）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# メール確認リンクの戻り先（本番は Vercel の URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# サーバー専用（ブラウザに公開しないこと）
# レシート読み取り（Claude API）。未設定の場合、デモモードでは仮データ、それ以外は手入力になります
ANTHROPIC_API_KEY=
# 読み取りに使うモデル（省略時 claude-opus-5-5）
RECEIPT_OCR_MODEL=
# 将来の管理処理用（現在未使用）
SUPABASE_SERVICE_ROLE_KEY=

# Supabase（未設定の場合、開発環境ではデモモードで起動します。本番環境では必須）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# メール確認リンクの戻り先（本番は Vercel の URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# サーバー専用（ブラウザに公開しないこと）
# レシート読み取り（Claude API）。未設定の場合、デモモードでは仮データ、それ以外は手入力になります
ANTHROPIC_API_KEY=
# 読み取りに使うモデル（省略時 claude-opus-5-5）
RECEIPT_OCR_MODEL=
# アカウントの削除（データ管理画面）に使う管理者キー。サーバー専用
SUPABASE_SERVICE_ROLE_KEY=

# 本番環境で Supabase なしのデモモードを公開する場合のみ true（通常は設定しない）
ALLOW_DEMO_MODE=
